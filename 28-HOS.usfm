\w you|x-occurrence="5" x-occurrences="7"\w*
\w like|x-occurrence="1" x-occurrences="1"\w*
\w Zeboiim|x-occurrence="1" x-occurrences="1"\w*—
\q2 \w cities|x-occurrence="1" x-occurrences="1"\w*
\w that|x-occurrence="1" x-occurrences="1"\w*
