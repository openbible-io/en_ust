\w you|x-occurrence="6" x-occurrences="7"\w*;
\q2 \w I|x-occurrence="7" x-occurrences="7"\w*
\w earnestly|x-occurrence="1" x-occurrences="1"\w*
\w long|x-occurrence="1" x-occurrences="1"\w*
\w to|x-occurrence="3" x-occurrences="3"\w*
\w have|x-occurrence="2" x-occurrences="2"\w*
